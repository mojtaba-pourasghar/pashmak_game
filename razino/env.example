# Razino — environment template.
#
# Copy to .env (which is git-ignored) and fill in. NOTHING here belongs in the
# repository, in a commit message, or in a chat with an AI assistant.

# ── content signing ──────────────────────────────────────────────────────────
# RSA private key used by content_tools/pack_chapter.py to sign chapter
# packages. The matching PUBLIC key is committed at
# resources/shared_assets/content_signing_public.key and ships inside the app.
# Generate a production pair with:
#   openssl genrsa -out razino-content.key 4096
#   openssl rsa -in razino-content.key -pubout -out content_signing_public.key
RAZINO_CONTENT_SIGNING_KEY=/secure/path/razino-content.key

# ── Cloudflare (content delivery) ────────────────────────────────────────────
# R2 holds the packages; a Worker serves the catalogue and signs download URLs.
# The game itself only ever sees the PUBLIC base URL below.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=razino-content
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# Public, and safe to ship — this is what goes into endpoints.default.cfg.
RAZINO_CONTENT_BASE_URL=https://content.example.ir
RAZINO_API_BASE_URL=https://api.example.ir

# ── database ─────────────────────────────────────────────────────────────────
# PostgreSQL behind the API: chapter catalogue, verified purchases, optional
# cloud progress. The game never connects to this directly.
DATABASE_URL=postgres://user:password@host:5432/razino

# ── store integrations ───────────────────────────────────────────────────────
# Server-side only. The client must never hold a merchant secret: receipts are
# verified by the API, which is the only thing that can grant an entitlement.
CAFEBAZAAR_PACKAGE_NAME=com.razino.game
CAFEBAZAAR_CLIENT_ID=
CAFEBAZAAR_CLIENT_SECRET=
CAFEBAZAAR_REFRESH_TOKEN=

MYKET_PACKAGE_NAME=com.razino.game
MYKET_API_KEY=

# ── Android release signing ──────────────────────────────────────────────────
# Needed only to build a release APK/AAB. Keep the keystore out of the repo and
# off any shared machine; losing it means losing the ability to update the app.
ANDROID_KEYSTORE_PATH=/secure/path/razino-release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=razino
ANDROID_KEY_PASSWORD=
