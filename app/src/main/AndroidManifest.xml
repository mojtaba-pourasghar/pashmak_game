<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!--
        From Android 11 an app cannot see other packages unless it says which ones it
        cares about. Without this TextToSpeech#getEngines comes back filtered, which
        would defeat the whole point of asking every installed engine whether it can
        speak Persian — and the store links below would silently fail to resolve.
        Nothing here is read or sent anywhere; it only makes these few apps visible.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <package android:name="com.farsitel.bazaar" />
        <package android:name="com.reecedunn.espeak" />
        <package android:name="com.github.olga_yakovleva.rhvoice.android" />
    </queries>

    <application
        android:name=".PashmakApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pashmak"
        tools:targetApi="31">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Pashmak.Splash"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.home.HomeActivity" android:exported="false" />
        <activity android:name=".ui.missions.MissionsActivity" android:exported="false" />
        <activity android:name=".ui.games.GamesActivity" android:exported="false" />
        <activity
            android:name=".ui.livedrawing.LiveDrawingActivity"
            android:exported="false" />
        <activity android:name=".ui.coloring.ColoringPickerActivity" android:exported="false" />
        <activity android:name=".ui.coloring.ColoringActivity" android:exported="false" />
        <activity android:name=".ui.freedraw.FreeDrawActivity" android:exported="false" />
        <activity android:name=".ui.tracing.TracingPickerActivity" android:exported="false" />
        <activity android:name=".ui.tracing.TracingActivity" android:exported="false" />
        <activity android:name=".ui.bubbles.BubblePopActivity" android:exported="false" />
        <activity android:name=".ui.memory.MemoryPickerActivity" android:exported="false" />
        <activity android:name=".ui.memory.MemoryActivity" android:exported="false" />
        <activity android:name=".ui.story.StoryPickerActivity" android:exported="false" />
        <activity android:name=".ui.story.StoryActivity" android:exported="false" />
        <activity
            android:name=".ui.lullaby.LullabyActivity"
            android:exported="false" />
        <activity android:name=".ui.tale.TalePickerActivity" android:exported="false" />
        <activity android:name=".ui.tale.TaleActivity" android:exported="false" />
        <activity android:name=".ui.gallery.GalleryActivity" android:exported="false" />
        <activity android:name=".ui.gallery.GalleryViewerActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
