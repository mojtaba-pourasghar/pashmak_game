<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Display type: Lalezar, the prototype's heading face. -->
    <style name="Text.Display" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/lalezar_regular</item>
        <item name="fontFamily">@font/lalezar_regular</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Title" parent="Text.Display">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink_primary</item>
    </style>

    <style name="Text.Section" parent="Text.Display">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/ink_slate</item>
    </style>

    <!-- Body type: Vazirmatn. -->
    <style name="Text.Body" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink_primary</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
    </style>

    <style name="Text.Body.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Sub" parent="Text.Body">
        <item name="android:textSize">@dimen/text_sub</item>
        <item name="android:textColor">@color/ink_tertiary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- The signature chunky 3D button. -->
    <style name="Button.Chunky" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">@font/lalezar_regular</item>
        <item name="fontFamily">@font/lalezar_regular</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Button.Chunky.Large">
        <item name="android:textSize">@dimen/text_button_lg</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">21dp</item>
    </style>

    <!-- Circular back / icon button. -->
    <style name="Button.Round" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/back_button</item>
        <item name="android:layout_height">@dimen/back_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_circle_white</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Small pill text button used in screen headers. -->
    <style name="Button.Pill" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">@font/lalezar_regular</item>
        <item name="fontFamily">@font/lalezar_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_chip_white</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Text.Chip" parent="Text.Body">
        <item name="android:textSize">@dimen/text_chip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/amber_shadow</item>
    </style>
</resources>
