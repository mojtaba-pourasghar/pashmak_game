<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        On a phone the games menu has to show all nine cards without scrolling, so
        the نقاشی زنده card takes a normal cell and the eight fall into three rows.
        A tablet has the height to give it the full-width headline it was designed as.
    -->
    <bool name="games_wide_headline">false</bool>

    <!--
        The story screen's side column has to hold Pashmak, the passage he is reading
        and, on a choice beat, two option buttons. On a phone that is 266dp for all
        three, and the passage is the part a child actually needs. So on phones only,
        the dock takes its smaller size; he stays at the top of the column where he
        can be seen, just not taking a third of it.
    -->
    <bool name="story_dock_small">true</bool>
</resources>
