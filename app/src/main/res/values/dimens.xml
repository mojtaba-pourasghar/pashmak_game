    <dimen name="text_display">28sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_section">17sp</dimen>
    <dimen name="text_button">16sp</dimen>
    <dimen name="text_button_lg">20sp</dimen>
    <dimen name="text_body">12sp</dimen>
    <dimen name="text_sub">10sp</dimen>
    <dimen name="text_chip">12sp</dimen>

    <dimen name="radius_sm">12dp</dimen>
    <dimen name="radius_md">18dp</dimen>
