<?xml version="1.0" encoding="utf-8"?>
<!--
    Baseline bucket: the SMALLEST screen the app supports.

    smallestWidth is the device's SHORTER edge and does not change when the screen is
    turned, so these four buckets are device sizes, not orientations. What does change
    is which edge is scarce: in landscape a 480x320 phone gives about 300dp of height
    and plenty of width, and in portrait exactly the other way round. So the same
    number serves both — it is the budget for whichever axis is the short one — and
    the landscape layouts spend it on height while the portrait ones spend it on
    width. Anything added here must also be considered for the other three buckets.
-->
<resources>
    <!-- Landscape three-band layout: start rail | center stage | end column -->
    <!-- The end rail the companion stands in on the list screens. -->
    <dimen name="rail_width">78dp</dimen>
    <dimen name="lullaby_column_width">200dp</dimen>
    <dimen name="end_column_width">168dp</dimen>
    <dimen name="screen_padding">10dp</dimen>
    <dimen name="screen_padding_v">8dp</dimen>
    <dimen name="list_box_padding">8dp</dimen>
    <dimen name="gap">8dp</dimen>
    <dimen name="gap_lg">10dp</dimen>

    <dimen name="back_button">38dp</dimen>
    <dimen name="back_glyph">19sp</dimen>

    <dimen name="text_display">28sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_section">17sp</dimen>
    <dimen name="text_choice">14sp</dimen>
    <dimen name="text_button">16sp</dimen>
    <dimen name="text_button_lg">20sp</dimen>
    <dimen name="text_body">12sp</dimen>
    <dimen name="text_sub">10sp</dimen>
    <dimen name="text_chip">12sp</dimen>

    <dimen name="radius_sm">12dp</dimen>
    <dimen name="radius_md">18dp</dimen>
    <dimen name="radius_lg">22dp</dimen>
    <dimen name="radius_xl">26dp</dimen>

    <dimen name="card_min_height">56dp</dimen>
    <dimen name="card_padding_top">6dp</dimen>
    <dimen name="card_padding_bottom">10dp</dimen>
    <dimen name="card_padding_h">8dp</dimen>
    <dimen name="card_icon_tile">36dp</dimen>
    <dimen name="card_icon">21dp</dimen>
    <dimen name="mascot_hero">168dp</dimen>
    <dimen name="mascot_home">128dp</dimen>
    <dimen name="mascot_inline">108dp</dimen>
    <dimen name="mascot_dock">86dp</dimen>
    <dimen name="mascot_dock_small">66dp</dimen>
    <dimen name="bubble_max_width">168dp</dimen>

    <!-- Thumbnail on a mission item card in the brief column. -->
    <dimen name="slot_thumb">28dp</dimen>
    <dimen name="slot_size">56dp</dimen>
    <dimen name="swatch_size">32dp</dimen>
    <dimen name="keypad_key">44dp</dimen>
    <dimen name="keypad_width">56dp</dimen>

    <!-- Bedtime transport: the play button and the two rows of controls under it. -->
    <dimen name="lullaby_play">56dp</dimen>
    <dimen name="lullaby_row">34dp</dimen>
    <!-- Prev/next need a real target; a child aims roughly. -->
    <dimen name="lullaby_step">44dp</dimen>
    <!-- The narration must not collapse when the choice buttons appear. -->
    <dimen name="story_line_min">40dp</dimen>
    <!-- Portrait: the side column becomes a band across the bottom. band_tools is
         what the buttons at the end of it get, band_min what the band itself cannot
         go under. In portrait the short edge is the WIDTH, so these are the same
         budget the landscape column spends on height, turned ninety degrees. -->
    <dimen name="band_tools">120dp</dimen>
    <dimen name="band_min">54dp</dimen>
</resources>
