<?xml version="1.0" encoding="utf-8"?>
<!-- The corner companion: a bubble that can be tapped, above a purely
     decorative mascot that must never swallow a tap meant for the game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="end"
    android:orientation="vertical">

    <ir.brandimo.pashmak.mascot.SpeechBubbleView
        android:id="@+id/dock_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_speech_bubble"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="9dp"
        android:visibility="gone" />

    <ir.brandimo.pashmak.mascot.MascotView
        android:id="@+id/dock_mascot"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/mascot_dock"
        android:layout_gravity="end"
        android:duplicateParentState="false"
        android:importantForAccessibility="no" />
</LinearLayout>
