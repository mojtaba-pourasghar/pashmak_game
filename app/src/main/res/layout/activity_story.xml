<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_story"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding_v">

    <include
        android:id="@+id/story_header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.brandimo.pashmak.ui.story.StorySceneView
        android:id="@+id/story_scene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_frame_scene"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/story_side"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/story_header" />

    <LinearLayout
        android:id="@+id/story_side"
        android:layout_width="@dimen/end_column_width"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/gap"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/story_header">
        <include
            android:id="@+id/story_dock"
            layout="@layout/view_mascot_dock_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- The stories run a minute or two, so a passage can be five lines on a
             small phone. It scrolls rather than being cut off, and the screen
             follows the words as Pashmak reads them. -->
        <ScrollView
            android:id="@+id/story_line_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_speech_story"
            android:fillViewport="true"
            android:minHeight="@dimen/story_line_min"
            android:scrollbars="none">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/story_line"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="@color/ink_primary"
                android:textSize="15sp"
                tools:text="یه روز صبح، نقاشیِ تو از کاغذ پرید بیرون…" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/story_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/story_choice_a"
                style="@style/Button.Chunky.Choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_purple"
                tools:text="بریم جنگل" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/story_choice_b"
                style="@style/Button.Chunky.Choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_blue"
                tools:text="بریم دریا" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/story_next"
            style="@style/Button.Chunky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_orange"
            android:text="@string/story_next"
            android:textSize="18sp" />
    </LinearLayout>

    <ir.brandimo.pashmak.mascot.ConfettiView
        android:id="@+id/story_confetti"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Floats over the centre stage beside Pashmak, so however long a line runs it
         never takes height from the tool column. -->
    <ir.brandimo.pashmak.mascot.SpeechBubbleView
        android:id="@+id/dock_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_speech_bubble"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/story_side"
        app:layout_constraintTop_toTopOf="@id/story_dock"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
