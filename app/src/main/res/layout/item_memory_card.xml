<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/bg_memory_card">

    <!-- match_parent, not 0dp: this is a FrameLayout, where 0dp is literally zero
         and the picture vanishes. fitCenter scales it down to the card. -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/card_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/card_glyph"
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:text="ب"
        tools:textColor="@color/purple"
        tools:visibility="visible" />

    <View
        android:id="@+id/card_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_back" />
</FrameLayout>
