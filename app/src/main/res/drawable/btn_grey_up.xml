<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grey_lock_shadow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:top="0dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/grey_lock"
                android:endColor="@color/grey_lock_end" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
