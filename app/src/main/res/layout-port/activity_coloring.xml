<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait. The page gets the whole width, and the palette gets a full-width row
     of its own under it — which suits a row of colour swatches far better than the
     narrow column it lives in when the screen is on its side. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_paint"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding_v">

    <include
        android:id="@+id/paint_header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.brandimo.pashmak.ui.coloring.ColoringCanvasView
        android:id="@+id/paint_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_frame_paint"
        app:layout_constraintBottom_toTopOf="@id/paint_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/paint_header" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/paint_banner"
        style="@style/Text.Body.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_banner_purple"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="@color/purple_ink"
        app:layout_constraintBottom_toTopOf="@id/paint_palette"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="یه رنگ انتخاب کن و روی قسمت درست بزن" />

    <ir.brandimo.pashmak.ui.common.SwatchBar
        android:id="@+id/paint_palette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/paint_side"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Two rows, not one. Across a phone held upright there is not enough width for
         Pashmak, a line of Persian and a column of buttons side by side — the line
         came out at 78dp, narrower than the column it replaced. So he shares the top
         row with the words and the buttons get the full width underneath. -->
    <LinearLayout
        android:id="@+id/paint_side"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:minHeight="@dimen/band_min"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/paint_dock"
                layout="@layout/view_mascot_dock_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/paint_legend_title"
                    style="@style/Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/purple_ink" />

                <!-- The legend can run to several rows on a busy page, so it scrolls
                     inside the band rather than pushing the band up over the page. -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/paint_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/paint_save"
                style="@style/Button.Chunky.Choice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_purple"
                android:text="@string/paint_save" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/paint_next"
                style="@style/Button.Chunky.Choice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_green"
                android:text="@string/paint_next"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ir.brandimo.pashmak.mascot.SpeechBubbleView
        android:id="@+id/dock_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_speech_bubble"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/paint_banner"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
