<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait. The passage gets the full width of the screen rather than a 168dp
     column, which is the single biggest thing this orientation buys the stories:
     the longest one drops from five lines to two. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_story"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding_v">

    <include
        android:id="@+id/story_header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.brandimo.pashmak.ui.story.StorySceneView
        android:id="@+id/story_scene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_frame_scene"
        app:layout_constraintBottom_toTopOf="@id/story_side"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/story_header" />

    <!-- Two rows, not one. Across a phone held upright there is not enough width for
         Pashmak, a line of Persian and a column of buttons side by side — the line
         came out at 78dp, narrower than the column it replaced. So he shares the top
         row with the words and the buttons get the full width underneath. -->
    <LinearLayout
        android:id="@+id/story_side"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:minHeight="@dimen/band_min"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/story_dock"
                layout="@layout/view_mascot_dock_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ScrollView
                android:id="@+id/story_line_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:background="@drawable/bg_speech_story"
                android:fillViewport="true"
                android:minHeight="@dimen/story_line_min"
                android:scrollbars="none">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/story_line"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="@color/ink_primary"
                    android:textSize="15sp"
                    tools:text="یه روز صبح، نقاشیِ تو از کاغذ پرید بیرون…" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/story_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/story_choice_a"
                style="@style/Button.Chunky.Choice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_purple"
                tools:text="بریم جنگل" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/story_choice_b"
                style="@style/Button.Chunky.Choice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_blue"
                tools:text="بریم دریا" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/story_next"
            style="@style/Button.Chunky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_orange"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/story_next"
            android:textSize="16sp" />
    </LinearLayout>

    <ir.brandimo.pashmak.mascot.ConfettiView
        android:id="@+id/story_confetti"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.brandimo.pashmak.mascot.SpeechBubbleView
        android:id="@+id/dock_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_speech_bubble"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/story_side"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
