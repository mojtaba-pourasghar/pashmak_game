<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait. The list of lullabies takes the height it wants down the screen and
     the player sits across the bottom with Pashmak beside it. The night sky is
     still the whole background; the bedtime screen is the one place in the app
     that plays no music of its own, so the player is the only thing on it. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_night"
    android:clipChildren="false">

    <ir.brandimo.pashmak.ui.lullaby.NightSkyView
        android:id="@+id/lullaby_sky"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/lullaby_header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/screen_padding_v"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lullaby_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_night_panel"
        android:padding="@dimen/list_box_padding"
        app:layout_constraintBottom_toTopOf="@id/lullaby_side"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lullaby_header"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="5"
        tools:listitem="@layout/item_lullaby" />

    <LinearLayout
        android:id="@+id/lullaby_side"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/gap"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding_v"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/lullaby_dock"
            layout="@layout/view_mascot_dock_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:background="@drawable/bg_night_panel"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lullaby_now_title"
                    style="@style/Text.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/night_gold"
                    android:textSize="18sp"
                    tools:text="لای‌لای گل پونه" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lullaby_now_line"
                    style="@style/Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/night_sub"
                    tools:text="بخواب ای ماه تابونه" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatSeekBar
                        android:id="@+id/lullaby_seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressTint="@color/night_gold"
                        android:progressBackgroundTint="@color/night_border"
                        android:thumbTint="@color/night_gold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/lullaby_time"
                        style="@style/Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/night_sub"
                        tools:text="۰:۳۲ / ۳:۰۰" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/lullaby_prev"
                        style="@style/Button.Round"
                        android:layout_width="@dimen/lullaby_step"
                        android:layout_height="@dimen/lullaby_step"
                        android:background="@drawable/bg_night_toggle"
                        android:contentDescription="@string/lullaby_prev"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:rotation="180"
                        android:src="@drawable/ic_next"
                        app:tint="@color/night_ink" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/lullaby_play"
                        style="@style/Button.Round"
                        android:layout_width="@dimen/lullaby_play"
                        android:layout_height="@dimen/lullaby_play"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/btn_yellow"
                        android:contentDescription="@string/lullaby_play"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        app:tint="@color/night_top" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/lullaby_next"
                        style="@style/Button.Round"
                        android:layout_width="@dimen/lullaby_step"
                        android:layout_height="@dimen/lullaby_step"
                        android:background="@drawable/bg_night_toggle"
                        android:contentDescription="@string/lullaby_next"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next"
                        app:tint="@color/night_ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/lullaby_repeat"
                        style="@style/Button.Chunky"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_night_toggle"
                        android:drawableStart="@drawable/ic_repeat"
                        android:drawablePadding="4dp"
                        android:text="@string/lullaby_repeat"
                        android:textColor="@color/night_ink"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/lullaby_auto"
                        style="@style/Button.Chunky"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_night_toggle"
                        android:drawableStart="@drawable/ic_auto_next"
                        android:drawablePadding="4dp"
                        android:text="@string/lullaby_auto"
                        android:textColor="@color/night_ink"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/lullaby_timer"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/night_sub" />

                    <LinearLayout
                        android:id="@+id/lullaby_timers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="horizontal" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/lullaby_timer_note"
                    style="@style/Text.Chip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/night_sub"
                    android:visibility="gone"
                    tools:text="۲۹:۱۲ تا خاموشی" />
            </LinearLayout>
    </LinearLayout>

    <ir.brandimo.pashmak.mascot.SpeechBubbleView
        android:id="@+id/dock_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_speech_bubble"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="11dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lullaby_side"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
