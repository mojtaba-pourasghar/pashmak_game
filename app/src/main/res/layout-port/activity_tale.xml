<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait. The scene takes the width and the passage runs full width under it;
     Pashmak and the transport sit in a band at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_story"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding_v">

    <include
        android:id="@+id/tale_header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ir.brandimo.pashmak.ui.tale.TaleSceneView
        android:id="@+id/tale_scene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_frame_scene"
        app:layout_constraintBottom_toTopOf="@id/tale_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tale_header" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tale_line"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_speech_story"
        android:minHeight="@dimen/story_line_min"
        android:padding="12dp"
        android:textColor="@color/ink_primary"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/tale_side"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="شب شده بود و ماه مثل یه قایق نقره‌ای روی آب نشسته بود." />

    <!-- Two rows, not one. Across a phone held upright there is not enough width for
         Pashmak, a line of Persian and a column of buttons side by side — the line
         came out at 78dp, narrower than the column it replaced. So he shares the top
         row with the words and the buttons get the full width underneath. -->
    <LinearLayout
        android:id="@+id/tale_side"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:minHeight="@dimen/band_min"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/tale_dock"
                layout="@layout/view_mascot_dock_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tale_progress"
                    style="@style/Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_sub"
                    tools:text="۳ از ۱۱" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tale_prev"
                        style="@style/Button.Round"
                        android:layout_width="@dimen/lullaby_step"
                        android:layout_height="@dimen/lullaby_step"
                        android:background="@drawable/bg_circle_white"
                        android:contentDescription="@string/tale_prev"
                        android:padding="10dp"
                        android:rotation="180"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next"
                        app:tint="@color/gold_ink" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tale_play"
                        style="@style/Button.Round"
                        android:layout_width="@dimen/lullaby_play"
                        android:layout_height="@dimen/lullaby_play"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/btn_orange"
                        android:contentDescription="@string/tale_pause"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause"
                        app:tint="@color/white" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tale_next"
                        style="@style/Button.Round"
                        android:layout_width="@dimen/lullaby_step"
                        android:layout_height="@dimen/lullaby_step"
                        android:background="@drawable/bg_circle_white"
                        android:contentDescription="@string/tale_next"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next"
                        app:tint="@color/gold_ink" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tale_next_tale"
            style="@style/Button.Chunky.Choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_yellow"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tale_next_tale"
            android:textColor="@color/gold_ink" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
