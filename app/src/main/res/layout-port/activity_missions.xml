<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait. The list has the whole width and Pashmak stands in a band under it,
     rather than in a rail beside it. The rule is the same one the landscape file
     states: he gets a space of his own so a scrolled card is never drawn across
     him. Turned ninety degrees, that space is a strip along the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_missions"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding_v"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding_v">

    <include
        android:id="@+id/missions_header"
        layout="@layout/view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/missions_hint"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/blue_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/missions_header"
        tools:text="پشمک هر بار یه مجموعه می‌خواد." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/missions_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_list_box"
        android:padding="@dimen/list_box_padding"
        app:layout_constraintBottom_toTopOf="@id/missions_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/missions_hint"
        tools:itemCount="6"
        tools:listitem="@layout/item_mission" />

    <LinearLayout
        android:id="@+id/missions_rail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/band_min"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/missions_dock"
            layout="@layout/view_mascot_dock_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
